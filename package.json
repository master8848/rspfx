{
  "name": "rspfx",
  "version": "0.0.12",
  "private": true,
  "type": "module",
  "description": "SPFx-compatible build toolchain powered by Rspack",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "typecheck": "pnpm -r --filter './packages/**' typecheck",
    "lint": "biome check . && node scripts/check-ts-only.mjs",
    "lint:fix": "biome check --write .",
    "check:ts-only": "node scripts/check-ts-only.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish": "node scripts/publish.mjs",
    "publish:dry": "node scripts/publish.mjs --dry-run",
    "bench": "node bench/bench.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.0",
    "happy-dom": "^15.11.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  }
}
