{
  "name": "rspfx",
  "version": "0.0.14",
  "private": true,
  "type": "module",
  "description": "SPFx-compatible build toolchain. Replaces Heft + webpack + gulp. Works with Vite, Rsbuild, and Rspack",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "biome check . && node scripts/check-ts-only.mjs",
    "lint:fix": "biome check --write .",
    "check:ts-only": "node scripts/check-ts-only.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish": "node scripts/publish.mjs",
    "publish:dry": "node scripts/publish.mjs --dry-run",
    "bench": "node bench/bench.mjs",
    "docs:dev": "bun run --filter docs-web dev",
    "docs:build": "bun run --filter docs-web build",
    "docs:preview": "bun run --filter docs-web preview",
    "docs:deploy": "bun run --filter docs-web deploy",
    "docs:deploy:preview": "bun run --filter docs-web deploy:preview"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.0",
    "happy-dom": "^15.11.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*",
    "docs-web"
  ]
}
