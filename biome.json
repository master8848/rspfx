{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "files": {
    "ignore": [
      "dist",
      "node_modules",
      ".rspfx",
      ".rspack-cache",
      "release",
      "sharepoint",
      "coverage",
      "bench/skeletons",
      "bench/.official-work",
      "examples",
      "tmp",
      "tmp/**"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "overrides": [
    {
      "include": ["**/*.json", "**/*.mjs", "**/*.js"],
      "linter": { "enabled": false }
    }
  ]
}
