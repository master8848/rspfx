{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmitOnError": true,
    "baseUrl": ".",
    "paths": {
      "@mbsks/rspfx-core": ["packages/core/src/index.ts"],
      "@mbsks/rspfx-core/headless": ["packages/core/src/headless.ts"],
      "@mbsks/rspfx-core/webpart": ["packages/core/src/base-web-part.ts"],
      "@mbsks/rspfx-core/platform": ["packages/core/src/platform.ts"],
      "@mbsks/rspfx-core/inline-css": ["packages/core/src/inline-css.ts"],
      "@mbsks/rspfx-plugin-api": ["packages/plugin-api/src/index.ts"],
      "@mbsks/rspfx-diagnostics": ["packages/diagnostics/src/index.ts"],
      "@mbsks/rspfx-compiler-rspack": ["packages/compiler-rspack/src/index.ts"],
      "@mbsks/rspfx-plugin": ["packages/plugin/src/index.ts"],
      "@mbsks/rspfx-build-core": ["packages/build-core/src/index.ts"],
      "@mbsks/rspfx-manifest-generator": ["packages/manifest-generator/src/index.ts"],
      "@mbsks/rspfx-sppkg-builder": ["packages/sppkg-builder/src/index.ts"],
      "@mbsks/rspfx-manifest-server": ["packages/manifest-server/src/index.ts"],
      "@mbsks/rspfx-dev-runtime": ["packages/dev-runtime/src/index.ts"],
      "@mbsks/rspfx-dev-runtime/vite-shared": ["packages/dev-runtime/src/vite-shared.ts"],
      "@mbsks/rspfx-framework-vanilla": ["packages/framework-vanilla/src/index.ts"],
      "@mbsks/rspfx-framework-vanilla/headless": ["packages/framework-vanilla/src/headless.ts"],
      "@mbsks/rspfx-framework-vanilla/webpart": ["packages/framework-vanilla/src/webpart.ts"],
      "@mbsks/rspfx-framework-react": ["packages/framework-react/src/index.ts"],
      "@mbsks/rspfx-framework-react/headless": ["packages/framework-react/src/headless.ts"],
      "@mbsks/rspfx-framework-react/webpart": ["packages/framework-react/src/webpart.ts"],
      "@mbsks/rspfx-framework-solid": ["packages/framework-solid/src/index.ts"],
      "@mbsks/rspfx-framework-solid/headless": ["packages/framework-solid/src/headless.ts"],
      "@mbsks/rspfx-framework-solid/webpart": ["packages/framework-solid/src/webpart.ts"],
      "@mbsks/rspfx-framework-preact": ["packages/framework-preact/src/index.ts"],
      "@mbsks/rspfx-framework-preact/headless": ["packages/framework-preact/src/headless.ts"],
      "@mbsks/rspfx-framework-preact/webpart": ["packages/framework-preact/src/webpart.ts"],
      "@mbsks/rspfx-framework-vue": ["packages/framework-vue/src/index.ts"],
      "@mbsks/rspfx-framework-vue/headless": ["packages/framework-vue/src/headless.ts"],
      "@mbsks/rspfx-framework-vue/webpart": ["packages/framework-vue/src/webpart.ts"],
      "@mbsks/rspfx-framework-svelte": ["packages/framework-svelte/src/index.ts"],
      "@mbsks/rspfx-framework-svelte/headless": ["packages/framework-svelte/src/headless.ts"],
      "@mbsks/rspfx-framework-svelte/webpart": ["packages/framework-svelte/src/webpart.ts"],
      "@mbsks/rspfx-sharepoint-runtime": ["packages/sharepoint-runtime/src/index.ts"],
      "@mbsks/rspfx-sharepoint-runtime/local-bootstrap": ["packages/sharepoint-runtime/src/local-bootstrap.ts"],
      "@mbsks/rspfx-sharepoint-runtime/platform-modules": ["packages/sharepoint-runtime/src/platform-modules.ts"],
      "@mbsks/rspfx-fluent-adapter": ["packages/fluent-adapter/src/index.ts"],
      "@mbsks/rspfx-templates": ["packages/templates/src/index.ts"],
      "@mbsks/rspfx-webpart-base": ["packages/webpart-base/src/index.ts"],
      "@mbsks/rspfx-webpart-base/define": ["packages/webpart-base/src/define.ts"]
    }
  }
}
