{
  "name": "@mbsks/rspfx-framework-preact",
  "version": "0.0.13",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./webpart": {
      "types": "./dist/webpart.d.ts",
      "import": "./dist/webpart.js",
      "default": "./dist/webpart.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "default": "./dist/headless.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@mbsks/rspfx-core": "workspace:*",
    "@mbsks/rspfx-plugin-api": "workspace:*",
    "@mbsks/rspfx-webpart-base": "workspace:*",
    "@prefresh/babel-plugin": "^0.5.2",
    "@prefresh/vite": "^2.4.12",
    "@rspack/plugin-preact-refresh": "^1.0.0",
    "babel-loader": "^9.2.1"
  },
  "peerDependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "preact": "^10.24.0"
  },
  "description": "RSPFX Preact framework preset and web part base class",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/master8848/rspfx.git"
  }
}
