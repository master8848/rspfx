{
  "name": "@mbsks/rspfx-plugin",
  "version": "0.0.11",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mbsks/rspfx-compiler-rspack": "workspace:*",
    "@mbsks/rspfx-core": "workspace:*",
    "@mbsks/rspfx-dev-runtime": "workspace:*",
    "@mbsks/rspfx-diagnostics": "workspace:*",
    "@mbsks/rspfx-manifest-generator": "workspace:*",
    "@mbsks/rspfx-manifest-server": "workspace:*",
    "@mbsks/rspfx-plugin-api": "workspace:*",
    "@rspack/core": "^1.2.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.9",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.1.9"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "description": "RSPFX bundler plugins: RspfxPlugin (Rspack/Webpack-compatible), rspfxVite (Vite) and rspfxRsbuild (Rsbuild) carrying the single project config object",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/master8848/rspfx.git"
  }
}
