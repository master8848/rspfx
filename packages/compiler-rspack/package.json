{
  "name": "@mbsks/rspfx-compiler-rspack",
  "version": "0.0.15",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./helpers/css": {
      "types": "./dist/helpers/css.d.ts",
      "import": "./dist/helpers/css.js",
      "default": "./dist/helpers/css.js"
    },
    "./helpers/inline-css": {
      "types": "./dist/helpers/inline-css.d.ts",
      "import": "./dist/helpers/inline-css.js",
      "default": "./dist/helpers/inline-css.js"
    }
  },
  "files": ["dist"],
  "license": "MIT",
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@rspack/core": "^1.2.0",
    "@rspack/dev-server": "^1.0.0",
    "sass": "^1.83.0",
    "sass-loader": "^16.0.4",
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "postcss": "^8.4.49",
    "postcss-loader": "^8.1.1"
  },
  "devDependencies": {
    "valibot": "1.4.2",
    "@mbsks/rspfx-build-core": "workspace:*",
    "@mbsks/rspfx-core": "workspace:*",
    "@mbsks/rspfx-diagnostics": "workspace:*",
    "@mbsks/rspfx-framework-react": "workspace:*",
    "@mbsks/rspfx-plugin-api": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "description": "RSPFx Rspack compiler: config factory, TS/SWC, SCSS, asset pipeline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/master8848/rspfx.git"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  }
}
