{
  "name": "@mbsks/rspfx-framework-solid",
  "version": "0.0.15",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./webpart": {
      "types": "./dist/webpart.d.ts",
      "import": "./dist/webpart.js",
      "default": "./dist/webpart.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "default": "./dist/headless.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@mbsks/rspfx-core": "workspace:*",
    "@mbsks/rspfx-plugin-api": "workspace:*",
    "@mbsks/rspfx-webpart-base": "workspace:*",
    "babel-loader": "^9.2.1",
    "babel-preset-solid": "^1.9.4",
    "solid-refresh": "^0.7.8",
    "vite-plugin-solid": "^2.11.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "solid-js": "^1.9.4"
  },
  "description": "RSPFx Solid framework preset and web part base class",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/master8848/rspfx.git"
  }
}
