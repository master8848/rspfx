{
  "name": "@mbsks/rspfx-dev-runtime",
  "version": "0.0.15",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite-shared": {
      "types": "./dist/vite-shared.d.ts",
      "import": "./dist/vite-shared.js",
      "default": "./dist/vite-shared.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {},
  "description": "RSPFx dev runtime: serve emulation, websocket refresh, fast refresh",
  "repository": {
