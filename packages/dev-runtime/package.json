    "url": "git+https://github.com/master8848/rspfx.git"
  },
  "sideEffects": false,
  "devDependencies": {
    "@mbsks/rspfx-compiler-rspack": "workspace:*",
    "@mbsks/rspfx-core": "workspace:*",
    "@mbsks/rspfx-diagnostics": "workspace:*",
    "@mbsks/rspfx-framework-preact": "workspace:*",
    "@mbsks/rspfx-framework-react": "workspace:*",
    "@mbsks/rspfx-framework-solid": "workspace:*",
    "@mbsks/rspfx-framework-svelte": "workspace:*",
    "@mbsks/rspfx-framework-vanilla": "workspace:*",
    "@mbsks/rspfx-framework-vue": "workspace:*",
    "@mbsks/rspfx-manifest-generator": "workspace:*",
    "@mbsks/rspfx-manifest-server": "workspace:*",
    "@mbsks/rspfx-plugin-api": "workspace:*",
    "@mbsks/rspfx-sharepoint-runtime": "workspace:*"
  }
