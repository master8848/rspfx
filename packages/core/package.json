{
  "name": "@mbsks/rspfx-core",
  "version": "0.0.13",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./webpart": {
      "types": "./dist/base-web-part.d.ts",
      "import": "./dist/base-web-part.js",
      "default": "./dist/base-web-part.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js",
      "default": "./dist/platform.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@microsoft/sp-core-library": "*",
    "@microsoft/sp-webpart-base": "*"
  },
  "devDependencies": {
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2"
  },
  "description": "Zero-dependency core for RSPFX: SPFx types, base web part, config, environment",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/master8848/rspfx.git"
  }
}
